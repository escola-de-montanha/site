---
import {filterAndSortPages} from "../components/header/utils";
import MdLayout from "./MdLayout.astro";

const {frontmatter} = Astro.props;
const socios = filterAndSortPages(import.meta.glob("../pages/socios/*.md", {eager: true}))
const crumbs = [{title: 'Socios', url: '/vantagens'}]
---

<MdLayout frontmatter={frontmatter} crumbs={crumbs} related={socios}>
    <slot />
</MdLayout>