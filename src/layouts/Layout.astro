---
import {ClientRouter} from 'astro:transitions';
import '../assets/styles/base.css';
import Header from "../components/Header.astro";
import MainHeading from "../components/MainHeading.astro";
const {title, crumbs, noCrumbs} = Astro.props;
const displayTitle = title ? `${title} | Associação Escola de Montanha` : 'Associação Escola de Montanha';
---
<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <meta name="generator" content={Astro.generator}/>
    <title>{displayTitle}</title>
    <ClientRouter/>
</head>
<body>
<div class="flex flex-col min-h-screen">
    <Header/>
    <MainHeading title={title} crumbs={crumbs} noCrumbs={noCrumbs}/>
    <main class="flex-grow p-4">
        <div class="lg:container mx-auto">
            <slot/>
        </div>
    </main>
    <footer class="bg-aem-brown p-4">Footer</footer>
</div>
</body>
</html>

