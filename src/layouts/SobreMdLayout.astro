---
import {filterAndSortPages} from "../components/header/utils";
import MdLayout from "./MdLayout.astro";

const {frontmatter} = Astro.props;
const sobre = filterAndSortPages(import.meta.glob("../pages/sobre/*.md", {eager: true}))
const crumbs = [{title: 'Sobre', url: '/sobre'}]
---

<MdLayout frontmatter={frontmatter} crumbs={crumbs} related={sobre}>
    <slot />
</MdLayout>