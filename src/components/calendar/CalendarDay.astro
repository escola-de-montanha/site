---
import {adjustWeekDayToMondayStart} from './utils'
const {info: {date, isCurrentMonth, events, invisible}} = Astro.props;

const isWeekend = adjustWeekDayToMondayStart(date.getDay()) >= 5;

const [bgColor, badgeColor] = (() => {
    if (invisible) {
        return ['hidden md:flex md:invisible', ''];
    } else if (isCurrentMonth && !isWeekend) {
        return ['bg-green-100', 'bg-aem-green-100']
    } else if (isCurrentMonth) {
        return ['bg-aem-green-100', 'bg-aem-green-900']
    } else {
        return ['hidden md:flex md:visible bg-gray-200 opacity-50', 'bg-gray-400']
    }
})();

function categoryColor(category) {
    switch (category) {
        case 'escalada':
            return 'bg-aem-gray';
        case 'canyoning':
            return 'bg-aem-blue';
        case 'montanhismo':
            return 'bg-aem-green-500'
        case 'institucional':
            return 'bg-aem-orange'
        case 'multi':
            return 'bg-purple-500'
        case 'socios'
            return ''bg-aem-lime'
        default:
            return 'bg-white'
    }
}
---

<div class={`relative min-h-8 md:aspect-square rounded ${bgColor} flex`}>
    <span class={`${badgeColor} w-8 text-center text-white p-2 float-left md:float-none md:rounded-full md:absolute md:bottom-2 md:left-2 text-xs`}>
        {date.getDate()}
    </span>
    <div class="w-full flex md:flex-col p-1 gap-1">
        {events.map(event =>
                <a href={event.url} class={`rounded grow ${categoryColor(event.category)}`}>
                    {event.name}
                </a>
        )}
    </div>
</div>